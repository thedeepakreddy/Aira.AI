# Base URL of the Aira gateway. Defaults to http://localhost:8787 when unset.
# Only non-secret values belong in this file: anything prefixed VITE_ is
# compiled into the browser bundle and is readable by anyone. Provider API keys
# live in services/gateway/.env and never here.
VITE_GATEWAY_URL=http://localhost:8787

# Dev-only identity shim, used while the gateway runs with AIRA_REQUIRE_AUTH=false.
VITE_AIRA_DEV_USER=

# Supabase project, from Project Settings -> API. The publishable (anon) key is
# meant to be public; the service_role/secret key must never appear here — it
# belongs to the gateway alone.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
