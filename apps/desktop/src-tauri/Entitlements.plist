<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The hardened runtime is on for release builds, and under it an Info.plist
    usage string is necessary but not sufficient: without the matching
    entitlement macOS refuses the microphone before the user is ever asked,
    which surfaced as "Aira needs microphone access to listen" with no prompt
    to grant it.
  -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!--
    The coding agent, the task fleet and the browser are separate executables
    Aira launches. The hardened runtime blocks a child that is not signed the
    same way; this permits it, which is what a supervisor app needs.
  -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- The gateway, the model providers, and every supervised runtime's loopback. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
