# ── Provider keys ─────────────────────────────────────────────────────────────
# Server-side only. These must never appear in the web bundle or the desktop app.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional Anthropic catalogue override. Same format as OPENAI_MODELS below.
# Leaving it empty uses the documented Opus 5 / Sonnet 5 / Haiku 4.5 defaults.
ANTHROPIC_MODELS=

# ── OpenAI catalogue ──────────────────────────────────────────────────────────
# Declared here rather than hardcoded, so no unverified model id or price ships
# in the source. Confirm both against OpenAI's current pricing page.
#   format: id|tier|contextWindow|inputPerMTok|outputPerMTok
#   tier is one of frontier, balanced, fast; prices may be omitted.
#   Pipe-delimited because model ids contain slashes and colons.
OPENAI_MODELS=

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Free key, no credit card: https://openrouter.ai/keys
# Models ending in ":free" cost nothing, which makes this the cheapest way to
# exercise the whole chain end to end before paid providers have credit.
#   format: id|tier|contextWindow|inputPerMTok|outputPerMTok  (prices optional)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=

# ── Gemini ────────────────────────────────────────────────────────────────────
# Google mirrors the OpenAI wire format, so Gemini needs no adapter of its own.
# Keys from https://aistudio.google.com/apikey — the free tier is real and is
# the cheapest way to keep every surface working. GOOGLE_API_KEY is accepted as
# an alias, since that is the name Google's own tooling uses.
#   format: id|tier|contextWindow|inPerMTok|outPerMTok  (prices optional)
#   Confirm ids and prices against Google's current model and pricing pages;
#   nothing here is hardcoded in the source for exactly that reason.
GEMINI_API_KEY=
GEMINI_MODELS=

# ── Other compatible providers ──────────────────────────────────────────────
# JSON array. Each entry needs a unique id, HTTPS baseURL, name of the environment
# variable holding its API key, and a pipe-delimited models string. This also
# supports a local server at an HTTP loopback URL. Select model ids from the
# provider's actual current catalogue; examples below are placeholders.
# AIRA_COMPATIBLE_PROVIDERS=[{"id":"vendor","baseURL":"https://api.vendor.example/v1","apiKeyEnv":"VENDOR_API_KEY","models":"verified-model-id|frontier|128000","maxTokensField":"max_tokens"}]
AIRA_COMPATIBLE_PROVIDERS=[]

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set to false ONLY for local testing. Every request costs real money, so an
# unauthenticated request is an unattributed bill.
AIRA_REQUIRE_AUTH=true

# Shared memory survives a restart only with Supabase and migrations 001 + 002.
# False disables all recording and model recall. Users can also pause their own
# memory in Workspace; that preference persists with Supabase.
AIRA_MEMORY=true

# ── Routing ───────────────────────────────────────────────────────────────────
# Optional per-surface overrides. Unset falls back to the tier defaults:
#   code -> frontier, voice -> fast, chat/task -> balanced
AIRA_ROUTE_CHAT=
AIRA_ROUTE_VOICE=
AIRA_ROUTE_CODE=
AIRA_ROUTE_TASK=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787
# Authenticated server defaults to 0.0.0.0; local auth-off mode to 127.0.0.1.
# Development auth cannot be exposed on a non-loopback interface.
# AIRA_HOST=127.0.0.1
# Per-user, per-instance request protection. Use shared ingress limits for more
# than one gateway replica. These are throughput limits, not a billing budget.
AIRA_MAX_CONCURRENT_REQUESTS=4
AIRA_REQUESTS_PER_MINUTE=120
# Web origins allowed to call the gateway. The packaged desktop app's origins
# (tauri://localhost, http://tauri.localhost) are always allowed and need not
# be listed here.
AIRA_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
