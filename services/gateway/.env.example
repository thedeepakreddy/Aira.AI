# ── Provider keys ─────────────────────────────────────────────────────────────
# Server-side only. These must never appear in the web bundle or the desktop app.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Reroutes a safety refusal to another model automatically (Anthropic beta).
# Set to false if your account does not have access to the beta flag.
ANTHROPIC_ENABLE_FALLBACKS=true

# ── OpenAI catalogue ──────────────────────────────────────────────────────────
# Declared here rather than hardcoded, so no unverified model id or price ships
# in the source. Confirm both against OpenAI's current pricing page.
#   format: id:tier:contextWindow:inputPerMTok:outputPerMTok
#   tier is one of frontier | balanced | fast; prices may be omitted.
OPENAI_MODELS=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set to false ONLY for local testing. Every request costs real money, so an
# unauthenticated request is an unattributed bill.
AIRA_REQUIRE_AUTH=true

# ── Routing ───────────────────────────────────────────────────────────────────
# Optional per-surface overrides. Unset falls back to the tier defaults:
#   code -> frontier, voice -> fast, chat/task -> balanced
AIRA_ROUTE_CHAT=
AIRA_ROUTE_VOICE=
AIRA_ROUTE_CODE=
AIRA_ROUTE_TASK=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787
AIRA_ALLOWED_ORIGINS=http://localhost:5180
