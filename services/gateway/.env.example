# ── Provider keys ─────────────────────────────────────────────────────────────
# Server-side only. These must never appear in the web bundle or the desktop app.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Reroutes a safety refusal to another model automatically (Anthropic beta).
# Set to false if your account does not have access to the beta flag.
ANTHROPIC_ENABLE_FALLBACKS=true

# ── OpenAI catalogue ──────────────────────────────────────────────────────────
# Declared here rather than hardcoded, so no unverified model id or price ships
# in the source. Confirm both against OpenAI's current pricing page.
#   format: id|tier|contextWindow|inputPerMTok|outputPerMTok
#   tier is one of frontier, balanced, fast; prices may be omitted.
#   Pipe-delimited because model ids contain slashes and colons.
OPENAI_MODELS=

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Free key, no credit card: https://openrouter.ai/keys
# Models ending in ":free" cost nothing, which makes this the cheapest way to
# exercise the whole chain end to end before paid providers have credit.
#   format: id|tier|contextWindow|inputPerMTok|outputPerMTok  (prices optional)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=

# ── Gemini ────────────────────────────────────────────────────────────────────
# Google mirrors the OpenAI wire format, so Gemini needs no adapter of its own.
# Keys from https://aistudio.google.com/apikey — the free tier is real and is
# the cheapest way to keep every surface working. GOOGLE_API_KEY is accepted as
# an alias, since that is the name Google's own tooling uses.
#   format: id|tier|contextWindow|inPerMTok|outPerMTok  (prices optional)
#   Confirm ids and prices against Google's current model and pricing pages;
#   nothing here is hardcoded in the source for exactly that reason.
GEMINI_API_KEY=
GEMINI_MODELS=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set to false ONLY for local testing. Every request costs real money, so an
# unauthenticated request is an unattributed bill.
AIRA_REQUIRE_AUTH=true

# ── Routing ───────────────────────────────────────────────────────────────────
# Optional per-surface overrides. Unset falls back to the tier defaults:
#   code -> frontier, voice -> fast, chat/task -> balanced
AIRA_ROUTE_CHAT=
AIRA_ROUTE_VOICE=
AIRA_ROUTE_CODE=
AIRA_ROUTE_TASK=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787
# Web origins allowed to call the gateway. The packaged desktop app's origins
# (tauri://localhost, http://tauri.localhost) are always allowed and need not
# be listed here.
AIRA_ALLOWED_ORIGINS=http://localhost:5180
